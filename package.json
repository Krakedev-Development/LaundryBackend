{
  "name": "laundry-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Laundry: pedidos, agenda, custodia, pagos y operación.",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:build && node --test --test-concurrency=1 \"dist-test/test/unit/*.test.js\"",
    "test:e2e": "node scripts/prepare-test-db.mjs && pnpm test:build && node --test --test-concurrency=1 \"dist-test/test/e2e/*.test.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "db:bootstrap": "ts-node --transpile-only prisma/bootstrap.ts",
    "db:seed:catalog": "ts-node --transpile-only prisma/seed-catalog.ts",
    "test:build": "tsc -p tsconfig.test.json",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
