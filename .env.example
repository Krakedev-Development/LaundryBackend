# Servidor
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# Base de datos (PostgreSQL en Docker). Usa 5433 para no chocar con un PostgreSQL local en 5432.
POSTGRES_USER=laundry
POSTGRES_PASSWORD=
POSTGRES_DB=laundry
POSTGRES_PORT=5433
DATABASE_URL=postgresql://laundry:CAMBIAR@localhost:5433/laundry?schema=public

# Autenticacion: secretos largos y aleatorios (>= 32 caracteres), distintos entre si.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=2592000

# Clave HMAC de los codigos de custodia (>= 32 caracteres, distinta de los secretos JWT).
HANDOFF_HMAC_SECRET=

# Correo saliente: codigos para restablecer la contrasena desde la app.
# Sin SMTP_HOST, el correo se escribe en la consola del backend (solo desarrollo).
# En produccion (NODE_ENV=production) SMTP_HOST es obligatorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Laundry Clean Fresh <no-reply@tudominio.com>"

# Primer administrador (solo lo usa `pnpm db:bootstrap`). No hay usuarios predefinidos.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
